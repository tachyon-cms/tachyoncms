--- a/src/lib.rs
+++ b/src/lib.rs
@@ -68,6 +68,19 @@ pub struct Decoder {
     avif: avif_parse::AvifData,
 }
 
+/// Decodes one AV1 item on its own (the bytes an AVIF item holds), on the calling thread,
