  "query": "SELECT c.relname AS \"name!\", i.indisvalid AS \"valid!\"\n           FROM pg_index i\n           JOIN pg_class c ON c.oid = i.indexrelid\n           WHERE i.indrelid = 'documents'::regclass\n             AND pg_get_expr(i.indpred, i.indrelid) LIKE '%' || $1 || '%'",
