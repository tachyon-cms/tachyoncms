  "query": "SELECT id, deleted_at IS NULL AS \"live!\",\n                  published AS \"data: Json<Map<String, Value>>\",\n                  draft AS \"draft: Json<Map<String, Value>>\"\n           FROM documents\n           WHERE tenant_id = $1 AND collection_id = $2 AND ($3::uuid IS NULL OR id > $3)\n           ORDER BY id\n           LIMIT $4",
