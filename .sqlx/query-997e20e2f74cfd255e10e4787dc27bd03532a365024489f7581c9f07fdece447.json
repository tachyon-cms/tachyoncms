  "query": "SELECT a.role, r.abilities\n           FROM accounts a\n           JOIN roles r ON r.tenant_id = a.tenant_id AND r.slug = a.role\n           JOIN documents d ON d.id = a.user_id AND d.deleted_at IS NULL\n           WHERE a.user_id = $1 AND a.tenant_id = $2",
