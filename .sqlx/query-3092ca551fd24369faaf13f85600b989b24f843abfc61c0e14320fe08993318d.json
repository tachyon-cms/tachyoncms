  "query": "SELECT f.id, f.collection_id, f.scope, f.filename FROM files f\n           JOIN documents d ON f.id IN (d.published_file, d.draft_file)\n           WHERE d.tenant_id = $1 AND d.id = $2\n           ORDER BY f.scope, f.id",
