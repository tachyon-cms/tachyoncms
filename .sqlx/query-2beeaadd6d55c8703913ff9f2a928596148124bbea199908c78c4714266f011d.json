{
  "db_name": "PostgreSQL",
  "query": "SELECT a.user_id, a.email, a.role, a.password_hash,\n                  (a.locked_until IS NOT NULL AND a.locked_until > now()) AS \"locked!\"\n           FROM accounts a JOIN documents d ON d.id = a.user_id\n           WHERE a.tenant_id = $1 AND lower(a.email) = lower($2) AND d.deleted_at IS NULL",
