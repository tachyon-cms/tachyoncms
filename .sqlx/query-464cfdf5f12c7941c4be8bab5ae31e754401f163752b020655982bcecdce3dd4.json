  "query": "SELECT d.id, d.collection_id FROM documents d\n           JOIN unnest($1::uuid[], $2::uuid[]) AS t(id, collection_id)\n             ON d.id = t.id AND d.collection_id = t.collection_id\n           WHERE d.tenant_id = $3 AND d.deleted_at IS NULL\n           FOR KEY SHARE OF d",
