{
  "db_name": "PostgreSQL",
  "query": "SELECT d.collection_id, d.id, r.copy, d.deleted_at IS NOT NULL AS \"trashed!\"\n           FROM relations r\n           JOIN documents d ON d.id = r.from_doc\n           WHERE r.tenant_id = $1 AND r.to_doc = $2 AND r.field_path = 'folder'\n             AND r.from_doc <> $2\n           ORDER BY d.id, r.copy",
